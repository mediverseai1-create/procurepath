NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only - never expose. Used by the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=
# AI provider (Gemini). Server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Selar checkout links (defaults are built in; override here if needed).
NEXT_PUBLIC_PAYMENT_LINK_GROWTH=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_SCALE=https://selar.com/97plan?currency=USD
# Stripe webhook signing secret (whsec_...) for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Amount (in cents) each plan's payment link charges; used to map a verified payment to a plan.
PLAN_AMOUNT_GROWTH_CENTS=
PLAN_AMOUNT_SCALE_CENTS=
# Production: https://procurepath.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
