NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only - never expose. Used by the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=
# AI provider (Gemini). Server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Payment links (provided by you). The org id is appended as client_reference_id.
NEXT_PUBLIC_PAYMENT_LINK_GROWTH=
NEXT_PUBLIC_PAYMENT_LINK_SCALE=
# Stripe webhook signing secret (whsec_...) for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Amount (in cents) each plan's payment link charges; used to map a verified payment to a plan.
PLAN_AMOUNT_GROWTH_CENTS=
PLAN_AMOUNT_SCALE_CENTS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
